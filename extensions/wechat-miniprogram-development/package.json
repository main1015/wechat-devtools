{
  "name": "wechat-miniprogram-development",
  "displayName": "wechat-miniprogram-development",
  "description": "Official vscode extension for wechat miniprogram",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.46.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "typscript",
    "javascript",
    "wechat",
    "miniprogram"
  ],
  "activationEvents": [
    "onCommand:wechat-miniprogram-development.helloWorld",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:css",
    "onLanguage:wxml"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wechat-miniprogram-development.restart",
        "title": "Wechat Miniprogram Development: Restart"
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "typescript-miniprogram-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "build": "webpack --mode production --devtool hidden-source-map && npm run copy",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "copy": "node ./copyPackage.js"
  },
  "dependencies": {
    "dayjs": "^1.11.0",
    "licia": "^1.36.0",
    "typescript-miniprogram-plugin": "file:./typescript-miniprogram-plugin",
    "vscode-languageclient": "7.0.0",
    "vscode-languageserver": "7.0.0",
    "vscode-languageserver-textdocument": "^1.0.4",
    "vscode-uri": "^3.0.3"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "14.x",
    "@types/vscode": "^1.65.0",
    "@tencent/eslint-config-extends": "git+https://git.woa.com/devtools/eslint-config-extends.git",
    "@vscode/test-electron": "^2.1.2",
    "glob": "^7.2.0",
    "mocha": "^9.2.1",
    "ts-loader": "^9.2.6",
    "typescript": "^4.5.5",
    "webpack": "^5.69.1",
    "webpack-cli": "^4.9.2"
  }
}